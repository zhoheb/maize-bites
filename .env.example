# Copy to .env and adjust. Never commit .env.
# These defaults are for the local docker-compose Postgres only.
# Blank values are optional; each comment says what happens without them.

# Postgres (used by docker-compose.yml)
POSTGRES_USER=maize
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maize_bites
POSTGRES_PORT=5432

# Shared by api, worker, and drizzle-kit
DATABASE_URL=postgres://maize:change-me@localhost:5432/maize_bites

# The web app's origin, no trailing slash. The api allows only this origin (CORS, writes);
# the worker uses it for links in alerts.
WEB_ORIGIN=http://localhost:5173

# apps/api and apps/worker
# development | test | production. development prints readable logs; anything else prints
# JSON lines. In production the api requires RESEND_API_KEY.
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# apps/api
API_PORT=3001
# Proxy hops in front of the API (for real client IPs in rate limits). 0 locally.
TRUST_PROXY=0

# Email (api: sign-in links; worker: alerts) via Resend. Optional in development: without a
# key, emails are printed to the api/worker logs so you can click sign-in links locally.
RESEND_API_KEY=
EMAIL_FROM=Maize Bites <onboarding@resend.dev>

# Web Push (VAPID). Optional: without keys, push alerts are off. Generate with:
#   pnpm --filter worker vapid:keys
# The api serves the public key; the worker signs pushes with the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach: mailto:you@umich.edu
VAPID_SUBJECT=

# apps/worker: contact address sent in the User-Agent of every feed request.
# Ingestion is disabled until this is set.
INGEST_CONTACT_EMAIL=
# apps/worker: which sources to ingest (true | false). See docs/sources.md.
# Happening @ Michigan JSON feed, hourly. A failing source never stops the other.
HAPPENING_ENABLED=true
# Maize Pages public events (official ICS feed, RSS as fallback), every 5 hours.
MAIZEPAGES_ENABLED=false

# apps/worker: how free food is decided (llm | rules).
#   llm   (default) Keyword rules pick candidates and claude-haiku-4-5 confirms each one. Needs
#         ANTHROPIC_API_KEY; without it nothing from a feed is published.
#   rules No LLM and no key. A stricter set of keyword rules is the final judge and its positives
#         are published. It only trusts explicit statements ("free pizza", "lunch provided"), so it
#         misses events the model would catch, and it can't read context, so expect some wrong
#         listings. Vocabulary: apps/worker/src/classifier/rules-config.ts.
# Switching back to llm re-checks everything rules mode decided.
CLASSIFIER_MODE=llm
# apps/worker: LLM classifier key. Only used in llm mode.
ANTHROPIC_API_KEY=
# Hard cap on Anthropic API requests per hourly run, retries included.
LLM_MAX_CALLS_PER_RUN=100

# apps/worker: retention. Events that ended more than EVENT_RETENTION_DAYS ago are deleted,
# with their classifications, reports, and alert log rows. The eval set keeps its own copies.
EVENT_RETENTION_DAYS=30
# How often the prune job runs: a divisor of 60, or whole hours that divide 24 (e.g. 60, 360).
PRUNE_INTERVAL_MINUTES=60
