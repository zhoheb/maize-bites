# Copy to .env and adjust. Never commit .env.
# These defaults are for the local docker-compose Postgres only.

# Postgres (used by docker-compose.yml)
POSTGRES_USER=maize
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maize_bites
POSTGRES_PORT=5432

# Shared by api, worker, and drizzle-kit
DATABASE_URL=postgres://maize:change-me@localhost:5432/maize_bites

# apps/api
API_PORT=3001
# The only browser origin CORS allows (the web app). No trailing slash.
WEB_ORIGIN=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Proxy hops in front of the API (for real client IPs in rate limits). 0 locally.
TRUST_PROXY=0

# Email (api: sign-in links; worker: alerts) via Resend. Without a key in development,
# emails are printed to the api/worker logs so you can click sign-in links locally.
RESEND_API_KEY=
EMAIL_FROM=Maize Bites <onboarding@resend.dev>

# Web Push (VAPID). Generate with: pnpm --filter worker vapid:keys
# The api serves the public key; the worker signs pushes with the private key.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact the push services can reach: mailto:you@umich.edu
VAPID_SUBJECT=


# apps/worker: contact address sent in the Happening @ Michigan User-Agent.
# Ingestion is disabled until this is set.
INGEST_CONTACT_EMAIL=

# apps/worker: LLM classifier (claude-haiku-4-5). Without a key, only the rules prefilter runs.
ANTHROPIC_API_KEY=
# Hard cap on Anthropic API requests per hourly run, retries included.
LLM_MAX_CALLS_PER_RUN=100
