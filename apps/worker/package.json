{
  "name": "@maize-bites/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --conditions=@maize-bites/source src/index.ts",
    "ingest:once": "tsx --conditions=@maize-bites/source src/cli/ingest-once.ts",
    "eval": "tsx --conditions=@maize-bites/source src/cli/eval.ts",
    "vapid:keys": "tsx src/cli/vapid-keys.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@maize-bites/db": "workspace:*",
    "@maize-bites/email": "workspace:*",
    "@maize-bites/shared": "workspace:*",
    "node-cron": "catalog:",
    "web-push": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/web-push": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
